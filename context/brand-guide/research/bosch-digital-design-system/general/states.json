{
  "schema_version": "1.0",
  "topic": {
    "name": "States",
    "slug": "states",
    "system": "Bosch Digital Design System",
    "document_area": "Design principles",
    "source_file": "States.html",
    "source_url": "https://brandguide.bosch.com/document/8130/en#/",
    "html_title": "States - Design principles - Bosch Digital Design System",
    "language": "en"
  },
  "purpose": {
    "summary": "UI states make interaction between the user and the application intuitive, efficient, and accessible by visually communicating the current condition of UI elements and giving feedback on user actions.",
    "applies_to_examples": [
      "buttons",
      "links",
      "form elements",
      "dropdowns",
      "switches",
      "checkboxes",
      "menu items",
      "option bars",
      "chips",
      "text fields"
    ],
    "accessibility_requirement": "Bosch UI element states comply with WCAG 2.1 accessibility requirements."
  },
  "standardization_note": {
    "type": "info",
    "message": "The content represents the standard definition for this topic. Depending on the digital touchpoint, such as Product UI, additional or deviating rules may apply."
  },
  "state_categories": [
    {
      "id": "interaction_states",
      "name": "Interaction states",
      "definition": "Interaction states help users understand which actions are possible and which action is currently being performed.",
      "purpose": "They indicate availability and status of UI elements, communicate possible actions, and confirm user actions. Consistent use improves learnability and efficiency, reduces frustration, and increases user satisfaction.",
      "groups": [
        {
          "id": "conventional_interaction_states",
          "name": "Conventional interaction states",
          "definition": "Conventional interaction states characterize the visual and functional reaction of an element to user interactions such as hover, click, or unavailability, ensuring direct feedback and orientation.",
          "states": [
            {
              "id": "default",
              "name": "Default",
              "definition": "The normal state of a UI element when there is no user interaction.",
              "usage": "Use this state to show that the element is available and ready for interaction.",
              "interaction_trigger": "No active user interaction",
              "examples_from_page": [
                "Dropdown",
                "Switch",
                "Secondary button"
              ]
            },
            {
              "id": "hovered",
              "name": "Hovered",
              "definition": "Occurs when the user hovers the cursor over the element.",
              "usage": "Use to provide visual feedback, highlight interactivity, and signal that the user can interact with the element.",
              "interaction_trigger": "Pointer hover",
              "examples_from_page": [
                "Dropdown",
                "Switch",
                "Secondary button"
              ]
            },
            {
              "id": "pressed",
              "name": "Pressed",
              "definition": "Activated when the user clicks or presses the element.",
              "usage": "Use to give immediate feedback that the user action has been registered.",
              "interaction_trigger": "Click, press, or active pointer interaction",
              "technical_reference": "CSS pseudo-class selector :active",
              "examples_from_page": [
                "Dropdown",
                "Switch",
                "Secondary button"
              ]
            },
            {
              "id": "disabled",
              "name": "Disabled",
              "definition": "Used when an element should temporarily not be interactable, for example because prerequisites have not yet been met.",
              "usage": "Use cautiously. Disabled states can reduce understanding, accessibility, and communication.",
              "interaction_trigger": "Element unavailable due to unmet conditions or temporary restriction",
              "risks": [
                {
                  "id": "understanding_issues",
                  "name": "Understanding Issues",
                  "description": "Users might not understand why an element is disabled or how they can activate it."
                },
                {
                  "id": "accessibility",
                  "name": "Accessibility",
                  "description": "Disabled elements can be hard to recognize, especially for users with visual impairments."
                },
                {
                  "id": "missed_communication",
                  "name": "Missed Communication",
                  "description": "A disabled element does not provide a way to explain the steps needed to activate it."
                }
              ],
              "recommended_alternatives": [
                {
                  "id": "error_messages_or_hints",
                  "name": "Error Messages or Hints",
                  "description": "Keep the element active and show a helpful message upon interaction explaining what is still needed."
                },
                {
                  "id": "progressive_disclosure",
                  "name": "Progressive Disclosure",
                  "description": "Design the UI flow so elements appear only when relevant."
                },
                {
                  "id": "visual_cues",
                  "name": "Visual Cues",
                  "description": "Use tooltips or help texts to show users how they can activate the element."
                }
              ],
              "examples_from_page": [
                "Dropdown",
                "Switch",
                "Secondary button"
              ]
            }
          ]
        },
        {
          "id": "special_interaction_states",
          "name": "Special interaction states",
          "states": [
            {
              "id": "focused",
              "name": "Focused",
              "definition": "Visual state that indicates which element, such as a button, link, or form field, has keyboard focus.",
              "usage": "Important for users who navigate with a keyboard instead of, or in addition to, a mouse or touchscreen.",
              "accessibility_rationale": "The Bosch Digital Design System defines a focus standard to ensure WCAG contrast across possible combinations with Bosch UI elements.",
              "focus_styles": [
                {
                  "id": "inner_focus",
                  "name": "Inner focus",
                  "specification": "3px inner inline using current background color, plus 3px outer inline using the plain pure enabled-front-default color scheme."
                },
                {
                  "id": "outer_focus",
                  "name": "Outer focus",
                  "specification": "3px inner outline using transparent color, plus 3px outer outline using plain pure enabled-front-default."
                },
                {
                  "id": "outer_inverted_focus",
                  "name": "Outer (inverted) focus",
                  "specification": "3px inner outline using plain pure enabled-front-default, plus 3px outer outline using current background color.",
                  "constraint": "Can only be used on floating components."
                }
              ]
            },
            {
              "id": "read_only",
              "name": "Read only",
              "definition": "Applied to components when the user is allowed to review but not modify the component.",
              "examples_from_page": [
                "Text field"
              ]
            },
            {
              "id": "dragging",
              "name": "Dragging",
              "definition": "Occurs when a user presses and moves an element or component.",
              "visual_composition": "Combination of the pressed state plus a small box shadow.",
              "examples_from_page": [
                "Chip"
              ]
            },
            {
              "id": "typing",
              "name": "Typing",
              "definition": "Used when a user is entering or editing text.",
              "visual_indicator": "The I-beam pointer shows the insertion position for text.",
              "implementation_note": "In standard web components, such as in the Frontend Kit, the typing state is usually replaced by the focused state by the browser.",
              "examples_from_page": [
                "Text field"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "selection_states",
      "name": "Selection states",
      "definition": "Selection states specify the state of the selection of one or more elements by the user.",
      "purpose": "They provide visual feedback on selected or available items, guide users through complex interactions, and help users keep track of decisions made.",
      "states": [
        {
          "id": "selected",
          "name": "Selected",
          "definition": "Indicates that a function is actively selected.",
          "examples_from_page": [
            "Checkbox",
            "Switch",
            "Menu item"
          ]
        },
        {
          "id": "deselected",
          "name": "Deselected",
          "definition": "Indicates that an element is no longer selected or is available for selection without currently being selected.",
          "visual_indication": "Can be indicated by returning to the original state or removing selection indicators.",
          "examples_from_page": [
            "Checkbox",
            "Switch",
            "Menu item"
          ]
        },
        {
          "id": "indeterminate",
          "name": "Indeterminate",
          "definition": "Describes a state in which the selection is not unique or there are mixed states, such as grouped checkboxes where some but not all items are selected.",
          "examples_from_page": [
            "Checkbox"
          ]
        },
        {
          "id": "active",
          "name": "Active",
          "definition": "Indicates that an element or page is actively selected.",
          "visual_indication": "The element is visually different from other elements to indicate that it is actively being interacted with.",
          "examples_from_page": [
            "Menu item",
            "Option bar"
          ]
        },
        {
          "id": "inactive",
          "name": "Inactive",
          "definition": "Default state of a menu item and similar elements when not currently active but still interactable.",
          "usage": "The user can activate the element by clicking it to perform the associated action.",
          "examples_from_page": [
            "Menu item",
            "Option bar"
          ]
        }
      ]
    }
  ],
