  "themes": {
    "light_theme": {
      "status": "default",
      "description": "Light Mode is the Bosch default. It uses bright and white backgrounds with selective functional color emphasis.",
      "background": "#ffffff",
      "text": "#000000",
      "link": "#007bc0",
      "usage_guidance": [
        "Use white content boxes",
        "Use color sparingly",
        "Prefer functional emphasis over decoration"
      ]
    },
    "dark_theme": {
      "status": "alternative",
      "description": "Dark Mode is for screens/UI in night or dark environments. It reverses the color impression: white becomes black, and backgrounds use dark base colors or Bosch Blue below 20.",
      "recommended_backgrounds": [
        "Bosch Gray 10",
        "Bosch Gray 05",
        "Bosch Blue 15",
        "Bosch Blue 10",
        "Bosch Blue 05"
      ],
      "accent_guidance": [
        "Flat elements on dark backgrounds should use the respective accent color",
        "Typefaces and delicate elements on dark backgrounds should use lighter accent gradations",
        "Example: Bosch Blue 50 on white can become Bosch Blue 70 on dark"
      ]
    }
  },
