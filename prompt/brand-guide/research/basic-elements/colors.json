  "core_principles": [
    {
      "id": "principle_color_restraint",
      "statement": "The Bosch color scheme relies on white and black with sparing use of one accent color, creating an open, breathable, reserved impression while leaving room for motif and brand promise.",
      "implication_for_ai": "Prefer neutral surfaces and restrained accents. Avoid making color the dominant visual element unless the use case is functional or tied to the Supergraphic."
    },
    {
      "id": "principle_supergraphic_contrast",
      "statement": "The colorful narrow Supergraphic provides liveliness and contrast against the reserved overall color impression.",
      "implication_for_ai": "Use the Supergraphic as a controlled visual contrast element rather than replacing it with broad decorative gradients."
    },
    {
      "id": "principle_one_accent_at_a_time",
      "statement": "Use one accent color at a time. Accent colors add vibrancy and differentiation without overwhelming the design.",
      "implication_for_ai": "When generating layouts, select one accent family such as Bosch Blue, Purple, Turquoise, or Green for a single composition unless a functional state requires another color."
    },
    {
      "id": "principle_functional_color",
      "statement": "Warning and notification colors have a functional character and are not general decorative design colors.",
      "implication_for_ai": "Reserve yellow, red, green, and blue functional states for warnings, errors, success, important notifications, and information."
    },
    {
      "id": "principle_no_gradients",
      "statement": "Gradients are not permitted. Use individual colors or lighter/darker gradations with the main accent color.",
      "implication_for_ai": "Do not create gradient fills from Bosch palette colors. Use discrete swatches, flat fills, or explicit gradation steps."
    },
    {
      "id": "principle_accessible_contrast",
      "statement": "Color gradations support accessibility and contrast. The background and text color distance should be at least 50 according to the guidance referenced in the page.",
      "implication_for_ai": "For text and delicate UI elements, use high-contrast combinations, typically black or white text, and check light/dark theme contrast."
    }
  ],
