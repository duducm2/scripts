; Environment Variables for AutoHotKey Scripts — TEMPLATE (tracked in git)
; Copy this file to env.ahk on each machine. env.ahk is gitignored and does not sync via git pull.
; After git pull, diff your local env.ahk against this file for new blocks.

; Base paths for scripts
global WORK_SCRIPTS_PATH := "C:\Users\fie7ca\Documents\01 - Scripts"
global PERSONAL_SCRIPTS_PATH := "C:\Users\eduev\Meu Drive\17 - Projects\scripts"

; ------------------------------------------------------------------------------
; Environment detection: identify work vs personal and apply environment-specific logic
; Set FORCE_ENVIRONMENT to "work" or "personal" to override auto-detection; leave blank to auto-detect.
; ------------------------------------------------------------------------------
global FORCE_ENVIRONMENT := ""   ; "work" | "personal" | "" (auto)

; Returns true if current system is detected as work environment, false for personal.
; Detection order: 1) FORCE_ENVIRONMENT  2) Script dir path  3) Computer name
_Env_DetectIsWork() {
    if (FORCE_ENVIRONMENT = "work")
        return true
    if (FORCE_ENVIRONMENT = "personal")
        return false
    ; Script path: personal path contains "Meu Drive" or "17 - Projects\scripts"; work contains "01 - Scripts" or user fie7ca
    scriptDir := A_ScriptDir
    if (InStr(scriptDir, "Meu Drive") || InStr(scriptDir, "17 - Projects\scripts"))
        return false
    if (InStr(scriptDir, "01 - Scripts") || InStr(scriptDir, "fie7ca"))
        return true
    ; Computer name: add known work hostnames here (e.g. "DESKTOP-ABC123" or "WORK-LAPTOP")
    ; if (A_ComputerName = "WORK-PC") return true
    return false
}

global IS_WORK_ENVIRONMENT := _Env_DetectIsWork()

; Function to get the correct script path based on environment
GetScriptPath(scriptName) {
    if (IS_WORK_ENVIRONMENT) {
        return WORK_SCRIPTS_PATH . "\" . scriptName
    } else {
        return PERSONAL_SCRIPTS_PATH . "\" . scriptName
    }
}

; Returns the scripts repo base path for the current environment (work vs personal).
; Return: current env path if set and exists; else other env path if exists; else current env path.
GetScriptsRepoPath() {
    global IS_WORK_ENVIRONMENT, WORK_SCRIPTS_PATH, PERSONAL_SCRIPTS_PATH
    path := IS_WORK_ENVIRONMENT ? WORK_SCRIPTS_PATH : PERSONAL_SCRIPTS_PATH
    if (path != "" && DirExist(path))
        return path
    other := IS_WORK_ENVIRONMENT ? PERSONAL_SCRIPTS_PATH : WORK_SCRIPTS_PATH
    if (other != "" && DirExist(other))
        return other
    return RTrim(IS_WORK_ENVIRONMENT ? WORK_SCRIPTS_PATH : PERSONAL_SCRIPTS_PATH, "\")
}

; Hunt and Peck executable paths
global HNP_EXE_PATH_WORK := "C:\\Users\\fie7ca\\Documents\\HuntAndPack\\hap.exe"
global HNP_EXE_PATH_PERSONAL := "C:\\Users\\eduev\\OneDrive\\Documentos\\HuntAndPeck\\hap.exe"

