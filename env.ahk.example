        return HNP_EXE_PATH_PERSONAL
    }
}

; PowerToys Peek executable paths (environment-specific)
global PEEK_EXE_PATH_PERSONAL := "C:\Users\eduev\AppData\Local\PowerToys\WinUI3Apps\PowerToys.Peek.UI.exe"
global PEEK_EXE_PATH_WORK := "C:\Users\fie7ca\AppData\Local\PowerToys\WinUI3Apps\PowerToys.Peek.UI.exe"   ; Work PC: adjust if different

; Returns the Peek executable path for the current environment (work vs personal).
; Return: current env path if it exists; else other env path if it exists; else current env path.
GetPeekExePath() {
    global IS_WORK_ENVIRONMENT, PEEK_EXE_PATH_WORK, PEEK_EXE_PATH_PERSONAL
    path := IS_WORK_ENVIRONMENT ? PEEK_EXE_PATH_WORK : PEEK_EXE_PATH_PERSONAL
    if (path != "" && FileExist(path))
        return path
    other := IS_WORK_ENVIRONMENT ? PEEK_EXE_PATH_PERSONAL : PEEK_EXE_PATH_WORK
    if (other != "" && FileExist(other))
        return other
    return IS_WORK_ENVIRONMENT ? PEEK_EXE_PATH_WORK : PEEK_EXE_PATH_PERSONAL
}

; QuickLook executable paths (used by Utils QuickLook / legacy Peek resolution). Leave blank to rely on PATH + "QuickLook.exe".
global QUICKLOOK_EXE_PATH_PERSONAL := "C:\QuickLook\QuickLook.exe"
global QUICKLOOK_EXE_PATH_WORK := ""   ; Work PC: set full path if QuickLook is installed

; Returns QuickLook.exe full path for current environment if configured and exists; else other env; else "" (caller falls back to PATH).
GetQuickLookExePath() {
    global IS_WORK_ENVIRONMENT, QUICKLOOK_EXE_PATH_WORK, QUICKLOOK_EXE_PATH_PERSONAL
    path := IS_WORK_ENVIRONMENT ? QUICKLOOK_EXE_PATH_WORK : QUICKLOOK_EXE_PATH_PERSONAL
    if (path != "" && FileExist(path))
        return path
    other := IS_WORK_ENVIRONMENT ? QUICKLOOK_EXE_PATH_PERSONAL : QUICKLOOK_EXE_PATH_WORK
    if (other != "" && FileExist(other))
        return other
    return ""
}

; Desktop folder path used by "Desktop to Recycle" macro (Win+Alt+Shift+U -> N)
global DESKTOP_TO_RECYCLE_PATH_WORK := ""   ; set on work PC, e.g. OneDrive Desktop
global DESKTOP_TO_RECYCLE_PATH_PERSONAL := ""   ; set on personal PC

GetDesktopToRecyclePath() {
    global IS_WORK_ENVIRONMENT, DESKTOP_TO_RECYCLE_PATH_WORK, DESKTOP_TO_RECYCLE_PATH_PERSONAL
    path := IS_WORK_ENVIRONMENT ? DESKTOP_TO_RECYCLE_PATH_WORK : DESKTOP_TO_RECYCLE_PATH_PERSONAL
    if (path != "" && DirExist(path))
        return path
    other := IS_WORK_ENVIRONMENT ? DESKTOP_TO_RECYCLE_PATH_PERSONAL : DESKTOP_TO_RECYCLE_PATH_WORK
    if (other != "" && DirExist(other))
        return other
    return A_Desktop   ; fallback
}

; Notes repository base path (study PDFs: Win+Alt+Shift+X selector; MyNotes technique prompts)
global NOTES_REPO_PATH_WORK := "C:\Users\fie7ca\OneDrive - Bosch Group\14-my-notes"
global NOTES_REPO_PATH_PERSONAL := "C:\Users\eduev\Meu Drive\17 - Projects\notes"

; Returns the notes repo base path for the current environment (work vs personal).
; Return: current env path if set and exists; else other env path if exists; else current env path.
GetNotesRepoPath() {
    global IS_WORK_ENVIRONMENT, NOTES_REPO_PATH_WORK, NOTES_REPO_PATH_PERSONAL
    path := IS_WORK_ENVIRONMENT ? NOTES_REPO_PATH_WORK : NOTES_REPO_PATH_PERSONAL
    if (path != "" && DirExist(path))
        return path
    other := IS_WORK_ENVIRONMENT ? NOTES_REPO_PATH_PERSONAL : NOTES_REPO_PATH_WORK
    if (other != "" && DirExist(other))
        return other
    return RTrim(IS_WORK_ENVIRONMENT ? NOTES_REPO_PATH_WORK : NOTES_REPO_PATH_PERSONAL, "\")
}

; Relative to notes repo root: six mnemonic / study technique prompts (single source of truth in MyNotes).
global MYNOTES_TECHNIQUE_PROMPTS_SUBPATH := "studies\technique\prompts"

; Returns directory containing the MyNotes technique prompt .txt files, or "" if none found.
; Optional: set env MYNOTES_TECHNIQUE_PROMPTS to the full prompts folder path (overrides auto-detection).
GetMyNotesTechniquePromptsDir() {
    global IS_WORK_ENVIRONMENT, NOTES_REPO_PATH_WORK, NOTES_REPO_PATH_PERSONAL, MYNOTES_TECHNIQUE_PROMPTS_SUBPATH
    envOverride := Trim(EnvGet("MYNOTES_TECHNIQUE_PROMPTS"), " `t`r`n")
    if (envOverride != "" && DirExist(envOverride))
        return envOverride
    root := GetNotesRepoPath()
    if (root != "") {
        p := root "\" MYNOTES_TECHNIQUE_PROMPTS_SUBPATH
        if DirExist(p)
            return p
    }
    ; Other machine clone (e.g. personal path exists on work PC)
    altRoot := IS_WORK_ENVIRONMENT ? NOTES_REPO_PATH_PERSONAL : NOTES_REPO_PATH_WORK
    if (altRoot != "" && altRoot != root) {
        p := altRoot "\" MYNOTES_TECHNIQUE_PROMPTS_SUBPATH
        if DirExist(p)
            return p
    }
    return ""
}

; Returns docs\context\work or docs\context\personal under the scripts repo for the current environment.
; Creates the env folder if missing so the context browser hotkey does not hard-fail on a fresh clone.
GetContextRootPath() {
    global IS_WORK_ENVIRONMENT
    repo := GetScriptsRepoPath()
    envName := IS_WORK_ENVIRONMENT ? "work" : "personal"
    path := RTrim(repo, "\") "\docs\context\" envName
    if !DirExist(path) {
        try DirCreate(path)
        catch {
        }
    }
    return path
}

